# Copier ce fichier en ".env" puis remplir les valeurs.

# Mot de passe du dashboard /host
HOST_PASSWORD=change-me

# Source musicale : spotify (par défaut) ou apple
MUSIC_PROVIDER=spotify

# --- Spotify (Premium requis pour l'hôte) ---
# developer.spotify.com/dashboard > Create app > Redirect URI : http://127.0.0.1:3000/host
# (l'app doit être en mode "Web Playback SDK"). Seul le Client ID est nécessaire, pas de secret.
SPOTIFY_CLIENT_ID=

# --- Apple Music (compte Apple Developer, 99 $/an) : seulement si MUSIC_PROVIDER=apple ---
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=YYYYYYYYYY
APPLE_PRIVATE_KEY_PATH=./AuthKey_YYYYYYYYYY.p8

# Pays du catalogue (ca, fr, be...)
STOREFRONT=ca

# URL que les invités peuvent atteindre (encodée dans le QR) : IP locale ou tunnel
PUBLIC_URL=http://192.168.1.50:3000
PORT=3000
MAX_PENDING_PER_GUEST=3

# Voix : la version gratuite joue des clips prégénérés (dossier voix/), sans clé.
# Annonces avec titre et prénom : passe payante (voix incluse), ou ton propre serveur de voix local :
#    lancer `python server/tts_server.py` dans le dossier Podcast, puis
#    TTS_BASE_URL=http://127.0.0.1:8020/v1
#    TTS_MODEL=chatterbox-multilingual
#    TTS_VOICE=chemin/vers/ton_echantillon.wav   (clone ta voix québécoise)
# TTS_BASE_URL=http://127.0.0.1:8020/v1

# Derrière un reverse proxy (Caddy/nginx sur un VPS) : mettre 1 pour que les limites utilisent la vraie IP
# TRUST_PROXY=1

# Tunnel / VPS (montage avancé) : derrière nginx et le tunnel SSH
# TRUST_PROXY=1        # lire la vraie adresse des invités (X-Forwarded-For posé par nginx)
# BIND=127.0.0.1       # écouter seulement ce PC et le tunnel (rien d'autre sur le réseau local)
