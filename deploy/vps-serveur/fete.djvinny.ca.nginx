# /etc/nginx/sites-available/djvinny-fete : le serveur DJ Vinny tourne sur le VPS (127.0.0.1:3011).
# Le dashboard est protégé par le mot de passe de l'hôte (cookie signé) ; /login est limité en essais.
server {
    server_name fete.djvinny.ca;

    location = /login {
        limit_req zone=djv_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:3011;
        include /etc/nginx/djvinny-proxy.conf;
    }

    location / {
        proxy_pass http://127.0.0.1:3011;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        client_max_body_size 2m;
        limit_req zone=djv_req burst=100 nodelay;
        limit_req_status 429;
        limit_conn djv_conn 250;
        limit_conn_status 429;
    }

    listen [::]:443 ssl;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/@CERT@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@CERT@/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    listen [::]:80;
    server_name fete.djvinny.ca;
    return 301 https://$host$request_uri;
}
